+          response = [422, {}, []]
+        end
+      elsif encoding
+        response = [415, {}, []]
       end
 
-      if env["HTTP_CONTENT_ENCODING"]
-        [415, {}, []]
-      else
-        @app.call(env)
-      end
+      response || @app.call(env)
     end
 
     def decode(input, content_encoding)
